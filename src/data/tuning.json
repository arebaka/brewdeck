[
	{
		"id": "hekate",
		"file": "bootloader/hekate_ipl.ini",
		"options": [
			{ "id": "autoboot", "type": "select", "values": ["off", "emummc", "sysmmc", "stock"], "default": "off" },
			{ "id": "bootwait", "type": "select", "values": [0, 1, 3, 5, 10], "default": 3 },
			{ "id": "backlight", "type": "range", "min": 0, "max": 255, "step": 5, "default": 100 },
			{ "id": "autohosoff", "type": "select", "values": [0, 1, 2], "default": 1 },
			{ "id": "autonogc", "type": "toggle", "default": true },
			{ "id": "updater2p", "type": "toggle", "default": true },
			{ "id": "bootprotect", "type": "toggle", "default": false }
		]
	},
	{
		"id": "nyx",
		"file": "bootloader/nyx.ini",
		"options": [
			{ "id": "themecolor", "type": "hue", "default": 167 },
			{ "id": "themebg", "type": "color", "default": "#2d2d2d" },
			{ "id": "homescreen", "type": "select", "values": [0, 1, 2, 3], "default": 0 },
			{ "id": "verification", "type": "select", "values": [0, 1, 2], "default": 1 },
			{ "id": "entries5col", "type": "toggle", "default": false }
		]
	},
	{
		"id": "dns",
		"file": "atmosphere/hosts",
		"options": [
			{ "id": "mode", "type": "select", "values": ["block", "default", "off"], "default": "block" },
			{ "id": "targets", "type": "multiselect", "values": ["emummc", "sysmmc"], "default": ["emummc"], "when": { "mode": ["block"] } }
		]
	},
	{
		"id": "exosphere",
		"file": "exosphere.ini",
		"options": [
			{ "id": "blank_prodinfo_emummc", "type": "toggle", "default": false },
			{ "id": "blank_prodinfo_sysmmc", "type": "toggle", "default": false }
		]
	},
	{
		"id": "atmosphere",
		"file": "atmosphere/config/system_settings.ini",
		"options": [
			{ "id": "upload_enabled", "type": "toggle", "default": false },
			{ "id": "usb30_force_enabled", "type": "toggle", "default": false },
			{ "id": "dmnt_cheats_enabled_by_default", "type": "toggle", "default": true },
			{ "id": "dmnt_always_save_cheat_toggles", "type": "toggle", "default": false },
			{ "id": "enable_external_bluetooth_db", "type": "toggle", "default": false },
			{ "id": "power_menu_reboot_function", "type": "select", "values": ["payload", "normal", "rcm"], "default": "payload" }
		]
	},
	{
		"id": "hbl",
		"file": "atmosphere/config/override_config.ini",
		"options": [
			{ "id": "album", "type": "toggle", "default": true },
			{ "id": "any_app", "type": "toggle", "default": true },
			{ "id": "key", "type": "select", "values": ["R", "L", "ZR", "ZL", "X", "Y", "MINUS", "PLUS"], "default": "R" }
		]
	},
	{
		"id": "tesla",
		"file": "config/tesla/config.ini",
		"requires": "ovlmenu",
		"options": [
			{ "id": "key_combo", "type": "multiselect", "values": ["L", "R", "ZL", "ZR", "DLEFT", "DUP", "DRIGHT", "DDOWN", "A", "B", "X", "Y", "LS", "RS", "MINUS", "PLUS"], "default": ["L", "DDOWN", "RS"] }
		]
	}
]
