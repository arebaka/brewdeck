{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"strictPropertyInitialization": true,
		"declaration": true,
		"sourceMap": false,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"baseUrl": ".",
		"declarationDir": "dist",
		"paths": {
			"@/*": ["src/*"],
			"@components/*": ["src/components/*"],
			"@data/*": ["data/*"],
			"@templates/*": ["templates/*"]
		}
	},
	"include": ["src", "tests", "vite.config.ts"]
}
