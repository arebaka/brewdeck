[
	{
		"id": "logo",
		"step": "launch",
		"file": "bootloader/hekate_ipl.ini",
		"options": [
			{ "id": "bootwait", "type": "select", "values": [0, 1, 3, 5, 10, 20], "default": 3 },
			{ "id": "noticker", "type": "toggle", "default": false }
		]
	},
	{
		"id": "hekate",
		"step": "system",
		"file": "bootloader/hekate_ipl.ini",
		"options": [
			{ "id": "backlight", "type": "range", "min": 0, "max": 255, "step": 5, "default": 100 },
			{ "id": "autohosoff", "type": "select", "values": [0, 1, 2], "default": 2 },
			{ "id": "autonogc", "type": "toggle", "default": true },
			{ "id": "updater2p", "type": "toggle", "default": true },
			{ "id": "bootprotect", "type": "toggle", "default": false }
		]
	},
	{
		"id": "nyx",
		"step": "system",
		"file": "bootloader/nyx.ini",
		"options": [
			{ "id": "themecolor", "type": "hue", "default": 167 },
			{ "id": "themebg", "type": "color", "default": "#2d2d2d" },
			{ "id": "homescreen", "type": "select", "values": [0, 1, 2, 3], "default": 0 },
			{ "id": "verification", "type": "select", "values": [0, 1, 2], "default": 1 },
			{ "id": "entries5col", "type": "toggle", "default": false },
			{ "id": "timedst", "type": "toggle", "default": true },
			{ "id": "umsemmcrw", "type": "toggle", "default": false },
			{ "id": "jcdisable", "type": "toggle", "default": false },
			{ "id": "jcforceright", "type": "toggle", "default": false },
			{ "id": "bpmpclock", "type": "select", "values": [0, 1, 2, 3, 4, 5], "default": 1 }
		]
	},
	{
		"id": "dns",
		"step": "security",
		"file": "atmosphere/hosts",
		"options": [
			{ "id": "mode", "type": "select", "values": ["block", "default", "off"], "default": "block" },
			{ "id": "targets", "type": "multiselect", "values": ["emummc", "sysmmc"], "default": ["emummc"], "when": { "mode": ["block"] } },
			{ "id": "add_defaults", "type": "toggle", "default": true, "when": { "mode": ["block", "default"] } },
			{ "id": "debug_log", "type": "toggle", "default": false, "when": { "mode": ["block", "default"] } }
		]
	},
	{
		"id": "exosphere",
		"step": "security",
		"file": "exosphere.ini",
		"options": [
			{ "id": "blank_prodinfo_emummc", "type": "toggle", "default": true },
			{ "id": "blank_prodinfo_sysmmc", "type": "toggle", "default": true },
			{ "id": "allow_writing_to_cal_sysmmc", "type": "toggle", "default": false },
			{ "id": "debugmode", "type": "toggle", "default": true },
			{ "id": "debugmode_user", "type": "toggle", "default": false },
			{ "id": "disable_user_exception_handlers", "type": "toggle", "default": false },
			{ "id": "enable_user_pmu_access", "type": "toggle", "default": false },
			{ "id": "enable_mem_mode", "type": "toggle", "default": false },
			{ "id": "log_port", "type": "select", "values": [0, 1, 2, 3], "default": 0 },
			{ "id": "log_baud_rate", "type": "number", "min": 0, "max": 4000000, "default": 115200 },
			{ "id": "log_inverted", "type": "toggle", "default": false }
		]
	},
	{
		"id": "atmosphere",
		"step": "system",
		"file": "atmosphere/config/system_settings.ini",
		"options": [
			{ "id": "upload_enabled", "type": "toggle", "default": false },
			{ "id": "usb30_force_enabled", "type": "toggle", "default": false },
			{ "id": "dmnt_cheats_enabled_by_default", "type": "toggle", "default": true },
			{ "id": "dmnt_always_save_cheat_toggles", "type": "toggle", "default": false },
			{ "id": "enable_external_bluetooth_db", "type": "toggle", "default": false },
			{ "id": "power_menu_reboot_function", "type": "select", "values": ["payload", "normal", "rcm"], "default": "payload" },
			{ "id": "fatal_auto_reboot_interval", "type": "select", "values": [0, 5000, 10000, 30000], "default": 0 },
			{ "id": "disable_automatic_report_cleanup", "type": "toggle", "default": false },
			{ "id": "ease_nro_restriction", "type": "toggle", "default": true },
			{ "id": "enable_log_manager", "type": "toggle", "default": false },
			{ "id": "enable_sd_card_logging", "type": "toggle", "default": true, "when": { "enable_log_manager": [true] } },
			{ "id": "sd_card_log_output_directory", "type": "text", "maxLength": 64, "default": "atmosphere/binlogs", "when": { "enable_log_manager": [true] } },
			{ "id": "enable_htc", "type": "toggle", "default": false },
			{ "id": "enable_am_debug_mode", "type": "toggle", "default": false },
			{ "id": "enable_hbl_bis_write", "type": "toggle", "default": false },
			{ "id": "enable_hbl_cal_read", "type": "toggle", "default": false },
			{ "id": "fsmitm_redirect_saves_to_sd", "type": "toggle", "default": false },
			{ "id": "applet_heap_size", "type": "number", "min": 0, "max": 4096, "default": 0 },
			{ "id": "applet_heap_reservation_size", "type": "number", "min": 0, "max": 4096, "default": 134 }
		]
	},
	{
		"id": "stratosphere",
		"step": "system",
		"file": "atmosphere/config/stratosphere.ini",
		"options": [
			{ "id": "nogc", "type": "select", "values": ["auto", "on", "off"], "default": "auto" }
		]
	},
	{
		"id": "hbl",
		"step": "system",
		"file": "atmosphere/config/override_config.ini",
		"options": [
			{ "id": "album", "type": "toggle", "default": false },
			{ "id": "any_app", "type": "toggle", "default": true },
			{ "id": "key", "type": "select", "values": ["R", "L", "ZR", "ZL", "X", "Y", "MINUS", "PLUS"], "default": "R" },
			{ "id": "mods_key", "type": "select", "values": ["L", "R", "ZL", "ZR", "X", "Y", "MINUS", "PLUS"], "default": "L" },
			{ "id": "cheat_key", "type": "select", "values": ["L", "R", "ZL", "ZR", "X", "Y", "MINUS", "PLUS"], "default": "L" },
			{ "id": "address_space", "type": "select", "values": ["39_bit", "36_bit", "32_bit"], "default": "39_bit" },
			{ "id": "path", "type": "text", "maxLength": 64, "default": "atmosphere/hbl.nsp" }
		]
	},
	{
		"id": "tesla",
		"step": "modules",
		"file": "config/tesla/config.ini",
		"requires": ["ovlmenu", "ultrahand"],
		"options": [
			{ "id": "key_combo", "type": "multiselect", "values": ["L", "R", "ZL", "ZR", "DLEFT", "DUP", "DRIGHT", "DDOWN", "A", "B", "X", "Y", "LS", "RS", "MINUS", "PLUS"], "default": ["L", "DDOWN", "RS"] }
		]
	},
	{
		"id": "sys_patch",
		"step": "modules",
		"file": "config/sys-patch/config.ini",
		"requires": "sys_patch",
		"options": [
			{ "id": "patch_sysmmc", "type": "toggle", "default": true },
			{ "id": "patch_emummc", "type": "toggle", "default": true },
			{ "id": "version_skip", "type": "toggle", "default": true },
			{ "id": "enable_logging", "type": "toggle", "default": true }
		]
	},
	{
		"id": "missioncontrol",
		"step": "modules",
		"file": "config/MissionControl/missioncontrol.ini",
		"requires": "missioncontrol",
		"options": [
			{ "id": "enable_rumble", "type": "toggle", "default": true },
			{ "id": "enable_motion", "type": "toggle", "default": true },
			{ "id": "analog_trigger_activation_threshold", "type": "range", "min": 0, "max": 100, "step": 5, "default": 50 },
			{ "id": "dualsense_lightbar_brightness", "type": "range", "min": 0, "max": 9, "step": 1, "default": 5 },
			{ "id": "dualsense_enable_player_leds", "type": "toggle", "default": true },
			{ "id": "dualsense_vibration_intensity", "type": "range", "min": 1, "max": 8, "step": 1, "default": 4 },
			{ "id": "dualshock4_lightbar_brightness", "type": "range", "min": 0, "max": 9, "step": 1, "default": 5 },
			{ "id": "dualshock3_enable_usb_pairing", "type": "toggle", "default": true },
			{ "id": "dualshock3_led_mode", "type": "select", "values": [0, 1, 2], "default": 0 },
			{ "id": "dualshock4_polling_rate", "type": "range", "min": 0, "max": 16, "step": 1, "default": 8 },
			{ "id": "host_name", "type": "text", "maxLength": 32, "default": "" }
		]
	},
	{
		"id": "status_monitor",
		"step": "modules",
		"file": "config/status-monitor/config.ini",
		"requires": "status_monitor",
		"options": [
			{ "id": "key_combo", "type": "multiselect", "values": ["L", "R", "ZL", "ZR", "DLEFT", "DUP", "DRIGHT", "DDOWN", "A", "B", "X", "Y", "LSTICK", "RSTICK", "MINUS", "PLUS"], "default": ["L", "DDOWN", "RSTICK"] },
			{ "id": "mini_show", "type": "multiselect", "values": ["CPU", "GPU", "RAM", "TEMP", "FAN", "DRAW", "FPS", "RES", "READ"], "default": ["CPU", "GPU", "RAM", "TEMP", "FAN", "DRAW", "FPS", "RES", "READ"] },
			{ "id": "micro_show", "type": "multiselect", "values": ["CPU", "GPU", "RAM", "BRD", "FAN", "FPS"], "default": ["CPU", "GPU", "RAM", "BRD", "FAN", "FPS"] },
			{ "id": "average_gpu_load", "type": "toggle", "default": false },
			{ "id": "touch_screen", "type": "toggle", "default": true },
			{ "id": "motion_control", "type": "toggle", "default": true },
			{ "id": "mini_font_size", "type": "range", "min": 10, "max": 30, "step": 1, "default": 15 },
			{ "id": "micro_font_size", "type": "range", "min": 10, "max": 30, "step": 1, "default": 18 },
			{ "id": "battery_avg_iir_filter", "type": "toggle", "default": false },
			{ "id": "battery_time_left_refreshrate", "type": "number", "min": 1, "max": 3600, "default": 60 },
			{ "id": "use_old_fps_average", "type": "toggle", "default": false },
			{ "id": "font_cache", "type": "toggle", "default": true }
		]
	},
	{
		"id": "sys_ftpd_light",
		"step": "modules",
		"file": "config/sys-ftpd/config.ini",
		"requires": "sys_ftpd_light",
		"options": [
			{ "id": "user", "type": "text", "maxLength": 32, "default": "", "secret": true },
			{ "id": "password", "type": "text", "maxLength": 32, "default": "", "secret": true },
			{ "id": "anonymous", "type": "toggle", "default": false },
			{ "id": "port", "type": "number", "min": 1, "max": 65535, "default": 5000 },
			{ "id": "pause", "type": "toggle", "default": true },
			{ "id": "keycombo", "type": "multiselect", "values": ["A", "B", "X", "Y", "LS", "RS", "L", "R", "ZL", "ZR", "PLUS", "MINUS", "DLEFT", "DUP", "DRIGHT", "DDOWN"], "default": ["X", "PLUS", "MINUS"], "when": { "pause": [true] } },
			{ "id": "led", "type": "toggle", "default": true }
		]
	},
	{
		"id": "dbi_patcher",
		"step": "modules",
		"file": "switch/DBI/translation.bin",
		"requires": "dbi_patcher",
		"options": [
			{ "id": "language", "type": "select", "values": ["be", "de", "en", "engb", "es", "es419", "et", "fr", "frca", "id", "it", "jp", "kk", "kr", "lt", "lv", "nl", "pl", "pt", "ptbr", "tr", "ua", "zhcn", "zhtw"], "default": "en" }
		]
	},
	{
		"id": "sys_clk",
		"step": "overclock",
		"file": "config/sys-clk/config.ini",
		"requires": "sys_clk",
		"options": [
			{ "id": "poll_interval_ms", "type": "number", "min": 50, "max": 5000, "default": 300 },
			{ "id": "temp_log_interval_ms", "type": "number", "min": 0, "max": 600000, "default": 0 },
			{ "id": "freq_log_interval_ms", "type": "number", "min": 0, "max": 600000, "default": 0 },
			{ "id": "power_log_interval_ms", "type": "number", "min": 0, "max": 600000, "default": 0 },
			{ "id": "csv_write_interval_ms", "type": "number", "min": 0, "max": 600000, "default": 0 }
		]
	}
]
